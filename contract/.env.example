# 複製成 .env 後填寫（.env 不會進 git）
# 部署用錢包私鑰（付 Gas）。部署後會先用這個錢包設定好配件與價格，再把 owner 轉給 NFT_OWNER
DEPLOYER_PRIVATE_KEY=

# 部署後要交給誰當 owner（建議 Safe 多簽 0x7c532A61349814633CdE4f81652Cb0E35BEB75f6）；留空＝部署者自己
# 轉移是兩步驟：部署腳本送出 transferOwnership，之後 Safe 要按 acceptOwnership
NFT_OWNER=
# 收款地址（USDT 直接轉到這裡）：Safe，或 AscPoint 金庫 0x9a431fED8Bc5fa595E5c9fdB1abb0a3119fBD5Ad（收入變成 ASC 持有者的獎金池）
TREASURY=
# Polygon USDT（主網才用；測試網會自動部署 tUSDT）
USDT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# metadata 網址（結尾要有 /）
BASE_URI=https://chase5ws.github.io/2026_asc_web3_ipfs/v2/metadata/
MAX_SUPPLY=500

# 價格（USDT，一般數字，可到小數點後 6 位）
PRICE_RANDOM=0
PRICE_CUSTOM=5
PRICE_CHANGE=2
PRICE_VIP=20
PRICE_GACHA=1
# 隨機鑄造每個錢包上限（0＝不限）
MAX_RANDOM_PER_WALLET=3
# 空投：部署後讀這個舊合約目前的持有者，每持有一顆就發一顆隨機配件的 V2（留空＝不空投；之後也可以由 owner 按 airdrop([地址…])）
AIRDROP_FROM=0x39c774673A25B0f1F600Bf39edF639c0f44a7488
# 部署後馬上開放鑄造（true／false）
SALE_OPEN=false

# 已部署的 V2 地址（status 腳本用）
NFT_V2_ADDRESS=

POLYGON_RPC_URL=
AMOY_RPC_URL=
POLYGONSCAN_API_KEY=
